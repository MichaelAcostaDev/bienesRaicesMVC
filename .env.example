# Configuración de Base de Datos para DESARROLLO LOCAL
# Copiar este archivo a .env y rellenar con tus valores locales
# NO incluir contraseñas reales en este archivo de ejemplo

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_PASSWORD=password
DB_NAME=bienes_raices

# Configuración de Email para DESARROLLO LOCAL
# Configurar con tus valores SMTP locales si quieres probar el contacto
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contraseña_app
EMAIL_PORT=587

# Nota: En producción (Wasmer), las variables se configuran a través del dashboard
# y las variables de DB son proporcionadas automáticamente por Wasmer
